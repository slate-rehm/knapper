{
  "name": "knapper",
  "version": "0.2.1",
  "description": "Drive a live Obsidian desktop app over MCP: develop and test Obsidian plugins, automate the vault and UI, and read console output. Use for anything involving Obsidian, its vaults, notes, or plugins.",
  "keywords": [
    "automation",
    "cdp",
    "devtools",
    "mcp",
    "model-context-protocol",
    "obsidian",
    "obsidian-plugin",
    "playwright",
    "plugin-development"
  ],
  "homepage": "https://github.com/slate-rehm/knapper#readme",
  "bugs": {
    "url": "https://github.com/slate-rehm/knapper/issues"
  },
  "license": "MIT",
  "author": "slate-rehm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slate-rehm/knapper.git"
  },
  "bin": {
    "knap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    "rules",
    ".mcp.json",
    ".cursor-plugin",
    ".claude-plugin",
    ".codex-plugin",
    ".agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/ci-smoke.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "e2e": "node scripts/e2e.mjs",
    "versions:check": "node scripts/sync-version.mjs --check",
    "versions:sync": "node scripts/sync-version.mjs",
    "prepare": "npm run versions:check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.78",
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/yargs": "^17.0.33",
    "playwright-core": "1.62.0-alpha-1783623505000",
    "typescript": "^5.8.3",
    "vite-plus": "0.2.6",
    "vitest": "^4.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.slate-rehm/knapper"
}
